# Dependencies
node_modules/

# Test output
coverage/
.vitest/

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Local developer-only test inputs (auth fixtures, brand fixtures, etc.).
# Files matching *.local.* are never committed.
*.local.*

# Brand-context render-test byproducts: the offline render suite
# (lib/render/brand-context-render.test.ts) renders into the committed golden
# fixtures and reads the output back, so these regenerate on every run.
testdata/clients/*/brand-context.html
testdata/clients/*/brand-context.headline.json
testdata/clients/*/brand-context.review.json

# Note: dist/ is committed. The plugin runtime invokes the built JS
# directly; users should not need to npm install to run the harness.
