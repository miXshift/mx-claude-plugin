{
  "name": "@mixshift/harness",
  "version": "0.0.1",
  "description": "Internal harness for the mixshift-ai plugin. Not user-facing — invoked by Claude via Bash tool during skill execution.",
  "private": true,
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "bin": {
    "mixshift": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-manifests": "tsx scripts/validate-manifests.mjs",
    "check-skills": "node scripts/check-skill-telemetry.mjs",
    "check-named-pack": "tsx scripts/check-named-pack.mjs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "commander": "^12.1.0",
    "mysql2": "^3.22.3",
    "undici": "^6.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.22.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
