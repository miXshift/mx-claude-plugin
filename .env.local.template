# Local env overrides for the mixshift-ai plugin.
#
# This is the TEMPLATE — committed to the repo so anyone cloning knows
# what to set. The real values live in `.env.local` (gitignored, your
# machine only).
#
# Setup:
#   cp .env.local.template .env.local
#   # then edit .env.local with the real values
#
# Lookup order at CLI startup (first file found wins):
#   1. ~/.mixshift/.env.local    (preferred — survives plugin reinstalls)
#   2. <plugin-root>/.env.local  (this directory — convenient for dev)
#
# Already-set shell variables ALWAYS win. If you `export
# MIXSHIFT_DISCORD_WEBHOOK=...` in your shell, the .env.local value is
# ignored.
#
# Format:
#   - One KEY=VALUE per line
#   - Lines starting with # are comments
#   - Blank lines OK
#   - Quotes optional (paired '' or "" get stripped)
#   - No multi-line values, no variable interpolation
#
# Never commit the populated version. .env.local is in .gitignore;
# .gitleaks runs in CI as a backstop.

# -----------------------------------------------------------------------
# Discord ops webhook (rotated after the 2026-05-13 leak — see
# internal/SECRETS.md). Routes IP whitelist requests, user feedback,
# table-access requests, and plugin crashes to the MixShift ops channel.
#
# Only MixShift's internal team needs this set today. Customers don't
# (their events will route via Supabase fan-out once that's deployed —
# see internal/SUPABASE-SETUP.md §10).
# -----------------------------------------------------------------------
MIXSHIFT_DISCORD_WEBHOOK=

# -----------------------------------------------------------------------
# Telemetry backend (Supabase). Populate once the project is set up per
# internal/SUPABASE-SETUP.md. The anon key is safe to embed (Supabase RLS
# enforces server-side); it's still an env var here so dev / prod / sandbox
# projects can swap without committing.
# -----------------------------------------------------------------------
# MIXSHIFT_TELEMETRY_ENDPOINT=https://<project-ref>.supabase.co/rest/v1/events
# MIXSHIFT_TELEMETRY_APIKEY=eyJ...

# -----------------------------------------------------------------------
# Disable telemetry entirely (for CI / sandboxed test runs that shouldn't
# emit events). Any of 0 / false / off / no / disabled works.
# -----------------------------------------------------------------------
# MIXSHIFT_TELEMETRY=0

# -----------------------------------------------------------------------
# Override the data directory (default: ~/.mixshift/). Useful for
# multi-tenant testing where one OS user needs to drive multiple
# isolated plugin states.
# -----------------------------------------------------------------------
# MIXSHIFT_DATA_DIR=/path/to/alternative/.mixshift
